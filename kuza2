#!/usr/bin/env bash
# Kuza CLI launcher. Prompts stay in argv and are never interpolated into code.

set -u
umask 077

KUZA_V2_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAEMON_DIR="${KUZA_STATE_DIR:-$HOME/.kuza-v2}"
PID_FILE="$DAEMON_DIR/kuza-v2.pid"
SOCKET_FILE="$DAEMON_DIR/kuza-v2.sock"

mkdir -p "$DAEMON_DIR"
chmod 700 "$DAEMON_DIR" 2>/dev/null || true

is_daemon_running() {
    [ -f "$PID_FILE" ] || return 1
    [ -S "$SOCKET_FILE" ] || return 1
    local daemon_pid
    daemon_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    [ -n "$daemon_pid" ] && kill -0 "$daemon_pid" 2>/dev/null
}

daemon_cli() {
    python3 "$KUZA_V2_DIR/core/daemon_cli.py" "$@"
}

case "${1:-}" in
    --daemon)
        python3 "$KUZA_V2_DIR/main.py" "$@"
        exit $?
        ;;
    status)
        daemon_cli status
        exit $?
        ;;
    task)
        shift
        daemon_cli task "$@"
        exit $?
        ;;
    cancel)
        shift
        daemon_cli cancel "$@"
        exit $?
        ;;
esac

background=false
for argument in "$@"; do
    if [ "$argument" = "--bg" ] || [ "$argument" = "--background" ]; then
        background=true
        break
    fi
done

if $background; then
    if ! is_daemon_running; then
        echo "Error: Daemon is not running. Start it with: kuzad2 start" >&2
        exit 1
    fi

    yolo_args=()
    prompt_parts=()
    for argument in "$@"; do
        case "$argument" in
            --yolo) yolo_args=(--yolo) ;;
            --bg|--background) ;;
            *) prompt_parts+=("$argument") ;;
        esac
    done
    if [ "${#prompt_parts[@]}" -eq 0 ]; then
        echo "Usage: kuza2 --bg \"task description\"" >&2
        exit 2
    fi
    prompt="${prompt_parts[*]}"
    daemon_cli queue "--prompt=$prompt" "${yolo_args[@]}"
    exit $?
fi

# The GUI costs meaningful RAM on a phone, so start it only when requested.
GUI_STARTED_HERE=false
if [ "${KUZA_AUTO_GUI:-0}" = "1" ] && [ -f "$KUZA_V2_DIR/gui/server.py" ]; then
    GUI_PORT="${KUZA_GUI_PORT:-8888}"
    GUI_PID_FILE="$DAEMON_DIR/gui-server.pid"
    if [ -f "$GUI_PID_FILE" ] && kill -0 "$(cat "$GUI_PID_FILE" 2>/dev/null)" 2>/dev/null; then
        echo "  GUI  →  http://localhost:${GUI_PORT}  (already running)"
    else
        export PYTHONUNBUFFERED=1
        export KUZA_GUI_PORT="$GUI_PORT"
        python3 "$KUZA_V2_DIR/gui/server.py" &
        echo $! > "$GUI_PID_FILE"
        GUI_STARTED_HERE=true
        echo "  GUI  →  http://localhost:${GUI_PORT}"
        trap 'kill "$(cat "$GUI_PID_FILE" 2>/dev/null)" 2>/dev/null; rm -f "$GUI_PID_FILE"' EXIT INT TERM
    fi
fi

python3 "$KUZA_V2_DIR/main.py" "$@"
exit_code=$?

if $GUI_STARTED_HERE; then
    : # EXIT trap performs cleanup.
fi

exit "$exit_code"
