#!/usr/bin/env bash
set -e

KUZA_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="$HOME/.kuza-v2/kuza-v2.pid"
LOG_FILE="$HOME/.kuza-v2/daemon.log"

mkdir -p "$HOME/.kuza-v2"

is_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case "${1:-status}" in
    start)
        if is_running; then
            echo "Kuza daemon is already running (PID $(cat "$PID_FILE"))."
            exit 0
        fi

        nohup python3 "$KUZA_DIR/main.py" --daemon \
            >> "$LOG_FILE" 2>&1 &

        sleep 2

        if is_running; then
            echo "Kuza daemon started (PID $(cat "$PID_FILE"))."
            echo "Log: $LOG_FILE"
        else
            echo "Kuza daemon failed to start."
            echo "Check: $LOG_FILE"
            exit 1
        fi
        ;;

    stop)
        if ! is_running; then
            rm -f "$PID_FILE"
            echo "Kuza daemon is not running."
            exit 0
        fi

        pid="$(cat "$PID_FILE")"
        kill "$pid"

        for _ in 1 2 3 4 5; do
            kill -0 "$pid" 2>/dev/null || break
            sleep 1
        done

        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid"
        fi

        rm -f "$PID_FILE" "$HOME/.kuza-v2/kuza-v2.sock"
        echo "Kuza daemon stopped."
        ;;

    status)
        if is_running; then
            echo "Kuza daemon is running (PID $(cat "$PID_FILE"))."
        else
            echo "Kuza daemon is stopped."
            exit 1
        fi
        ;;

    restart)
        "$0" stop || true
        "$0" start
        ;;

    logs)
        tail -n 100 "$LOG_FILE"
        ;;

    *)
        echo "Usage: kuzad2 {start|stop|status|restart|logs}"
        exit 2
        ;;
esac
