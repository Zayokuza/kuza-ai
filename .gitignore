# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
.env
.venv
venv/
env/

# ── Kuza-v2: user-generated / per-install files ──────────────────────────────
# Users generate these themselves after install — should NOT be in the repo
KUZA.md
CLAUDE.md

# ── Kuza-v2: runtime state ───────────────────────────────────────────────────
# Daemon state, logs, PID, socket, checkpoints, sessions
~/.kuza-v2/
.kuza-v2/
*.pid
*.sock
*.log
kuza_sessions/
.kuza_sessions/
checkpoints/

# ── Kuza-v2: knowledge base (auto-generated, per-install) ───────────────────
# 266MB of external content (cloned repos, chunk indexes, vector stores).
# Generated locally — never commit.
knowledge/

# ── Kuza-v2: model files ─────────────────────────────────────────────────────
# Models live in ~/models/, never committed
*.gguf
*.bin
*.safetensors
model/

# ── Kuza-v2: fine-tuning output ──────────────────────────────────────────────
*.jsonl
*.ipynb
kuza-finetune*/
kuza-lora*/
pipeline_output/retrieval/metadata.db
pipeline_output/pipeline_stats.json

